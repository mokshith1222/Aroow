<?xml version="1.0" encoding="utf-8"?>
<!-- Rules for Android 12+ (API 31+) -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Explicitly include Capacitor's SharedPreferences file -->
        <include domain="sharedpref" path="CapacitorStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="CapacitorStorage.xml" />
    </device-transfer>
</data-extraction-rules>
